{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart": {
          "type": "boolean"
        },
        "managedBy": {
          "type": "boolean"
        }
      }
    },
    "tee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "coco"
          ]
        },
        "coco": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtimeClassName": {
              "type": "string"
            },
            "allowMultiGpu": {
              "type": "boolean"
            },
            "podAnnotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "platform": {
              "type": "string",
              "enum": [
                "",
                "sev-snp",
                "tdx"
              ]
            },
            "allowHostProvidedCache": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "servedModelName": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hfTokenSecret": {
          "type": "string"
        },
        "apiKeySecret": {
          "type": "string"
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resourceName": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "emptyDir",
                "pvc"
              ]
            },
            "existingClaim": {
              "type": "string"
            },
            "sizeLimit": {
              "type": "string"
            }
          }
        },
        "shmSizeLimit": {
          "type": "string"
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": true
        },
        "engine": {
          "type": "string",
          "enum": [
            "vllm",
            "sglang"
          ]
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "shim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "evidenceSource": {
          "type": "string",
          "enum": [
            "auto",
            "none",
            "configfs-tsm"
          ]
        },
        "tsmPath": {
          "type": "string",
          "minLength": 1
        },
        "gpuEvidenceCmd": {
          "type": "string"
        },
        "allowPathPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "minItems": 1
        },
        "attestationRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775806
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "sans": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "cocoAAURL": {
          "type": "string",
          "pattern": "^http://(127\\.[0-9.]+|\\[::1\\])(:[0-9]+)?/?$"
        },
        "listenerAudit": {
          "type": "string",
          "enum": [
            "auto",
            "enforce",
            "warn",
            "off"
          ]
        },
        "extraVolumeMounts": {
          "type": "array"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": true
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
